[
  {
    "label": "httpYac: Send Request at Cursor",
    "command": "httpyac",
    "args": ["send", "$ZED_FILE", "--line", "$ZED_ROW", "--output", "body"],
    "reveal": "always",
    "use_new_terminal": false
  },
  {
    "label": "httpYac: Send Request (Full Headers + Body)",
    "command": "httpyac",
    "args": ["send", "$ZED_FILE", "--line", "$ZED_ROW", "--output", "exchange"],
    "reveal": "always",
    "use_new_terminal": false
  },
  {
    "label": "httpYac: Run All Requests in Current File",
    "command": "httpyac",
    "args": ["send", "$ZED_FILE", "--all"],
    "reveal": "always",
    "use_new_terminal": false
  },
  {
    "label": "httpYac: Run All Requests (luminair-dex.http)",
    "command": "httpyac",
    "args": ["send", ".ai/local/luminair-dex.http", "--all"],
    "reveal": "always",
    "use_new_terminal": false
  },
  {
    "label": "Luminair: Run Service (serve + auto-migrate)",
    "command": "cargo",
    "args": [
      "run",
      "-p",
      "infrastructure",
      "--",
      "--config",
      "config/cli-config.json",
      "--mode",
      "serve",
      "--auto-migrate",
      "--service-tokens",
      "local-dev-admin-token:ci-agent:admin"
    ],
    "reveal": "always",
    "use_new_terminal": true
  }
]
